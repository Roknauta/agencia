 <title height="128" splitType="Stretch">
  <element kind="staticText" x="0" y="0" width="511" height="30" fontSize="20" bold="true" forecolor="#24588C"><text><![CDATA[JBD Viagens]]></text></element>
  <element kind="staticText" x="0" y="34" width="511" height="28" fontSize="16" bold="true"><text><![CDATA[Contrato de intermediação de serviços de viagem]]></text></element>
  <element kind="textField" x="0" y="70" width="511" height="20" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA["Contratante: " + java.util.Objects.toString($F{cliente}, "Não informado")]]></expression></element>
  <element kind="textField" x="0" y="92" width="511" height="30" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA["Viagem: " + java.util.Objects.toString($F{origem}, "") + " → " + java.util.Objects.toString($F{destino}, "") + " | Período: " + ($F{inicio} == null ? "" : $F{inicio}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))) + " a " + ($F{fim} == null ? "" : $F{fim}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")))]]></expression></element>
 </title>
 <pageHeader height="28">
  <element kind="textField" x="0" y="2" width="511" height="22" fontSize="9" forecolor="#63758A" textAdjust="StretchHeight"><expression><![CDATA["Contrato " + java.util.Objects.toString($F{numero}, "") + " | Orçamento vinculado " + java.util.Objects.toString($F{numeroOrcamento}, "")]]></expression></element>
 </pageHeader>
 <detail><band height="1" splitType="Stretch">
  <element kind="subreport" positionType="Float" x="0" y="0" width="511" height="1">
   <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{conteudoContrato} == null ? java.util.Collections.emptyList() : $F{conteudoContrato})]]></dataSourceExpression>
   <expression><![CDATA[$P{RELATORIO_BLOCOS}]]></expression>
  </element>
 </band></detail>
 <summary height="140" splitType="Stretch">
  <element kind="staticText" x="0" y="8" width="511" height="36" fontSize="9"><text><![CDATA[Por estarem de acordo com os serviços, valores e condições deste contrato e do Anexo I, as partes assinam.]]></text></element>
  <element kind="line" x="0" y="82" width="235" height="1" forecolor="#243246"/>
