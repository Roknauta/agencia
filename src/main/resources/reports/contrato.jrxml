  <element kind="textField" x="276" y="88" width="235" height="32" fontSize="8" textAdjust="StretchHeight"><expression><![CDATA["Agência: " + java.util.Objects.toString($F{razaoSocialAgencia}, "")]]></expression></element>
  <element kind="textField" x="0" y="122" width="511" height="16" fontSize="8"><expression><![CDATA["Data da assinatura: " + java.util.Objects.toString($F{dataAssinatura}, "")]]></expression></element>
