				<printWhenExpression><![CDATA[$F{possuiPassagensAereas}]]></printWhenExpression>
				<expression><![CDATA["Passagem aérea (todos os passageiros): " + java.text.NumberFormat.getCurrencyInstance(java.util.Locale.forLanguageTag("pt-BR")).format($F{valorAereo}) + "\nValores por trecho: " + $F{resumoValoresAereos}]]></expression>
			</element>
			<element kind="textField" uuid="b16aaf80-63be-4974-ab74-4b52c0d099d6" positionType="Float" x="0" y="59" width="523" height="24" forecolor="#003366" fontSize="10.0" textAdjust="StretchHeight" blankWhenNull="true" removeLineWhenBlank="true" vTextAlign="Middle">
				<printWhenExpression><![CDATA[$F{possuiHospedagens}]]></printWhenExpression>
				<expression><![CDATA["Hospedagens (todos os hotéis e quartos): " + java.text.NumberFormat.getCurrencyInstance(java.util.Locale.forLanguageTag("pt-BR")).format($F{valorHospedagem})]]></expression>
			</element>
			<element kind="textField" uuid="a0cc409c-d6c5-431d-a05a-493a4db67f76" positionType="Float" x="0" y="253" width="523" height="24" forecolor="#003366" fontName="DejaVu Sans" fontSize="11.0" textAdjust="StretchHeight" blankWhenNull="true" removeLineWhenBlank="true" hTextAlign="Center" vTextAlign="Middle">
                <printWhenExpression><![CDATA[$F{desconto} != null && $F{desconto}.signum() > 0]]></printWhenExpression>
