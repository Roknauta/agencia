				<expression><![CDATA[$F{volta} == null ? "" : ($F{volta}.getResumoCabine() == null || $F{volta}.getResumoCabine().isBlank() ? "" : "Cabine: " + $F{volta}.getResumoCabine()) + ($F{volta}.getResumoTarifa() == null || $F{volta}.getResumoTarifa().isBlank() ? "" : ($F{volta}.getResumoCabine() == null || $F{volta}.getResumoCabine().isBlank() ? "" : "\n") + "Tarifa: " + $F{volta}.getResumoTarifa())]]></expression>
			</element>
